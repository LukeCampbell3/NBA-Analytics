# ============================================================
# Repo policy
# ============================================================
# Track source code, scripts, configs, tests, static assets, and data by default.
# Ignore only model artifacts/metadata, runtime outputs, caches, secrets, and local temp files.


# ============================================================
# Python / tooling caches
# ============================================================
__pycache__/
*.py[cod]
*$py.class

.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
coverage.xml
htmlcov/

.ipynb_checkpoints/


# ============================================================
# Virtual environments / local dependency folders
# ============================================================
.venv/
venv/
env/
ENV/
.envrc


# ============================================================
# Secrets / local-only config
# ============================================================
.env
.env.*
!.env.example

*.key
*.pem
*.p12
*.pfx

secrets/
private/


# ============================================================
# OS / editor noise
# ============================================================
.DS_Store
Thumbs.db
desktop.ini

.vscode/*
!.vscode/settings.json
!.vscode/extensions.json

.idea/


# ============================================================
# Logs / temp / runtime folders
# ============================================================
*.log
logs/
tmp/
temp/
.cache/

sports/**/tmp/
sports/**/logs/
Player-Predictor/tmp/
Player-Predictor/logs/


# ============================================================
# Model artifacts / model metadata
# ============================================================
# Explicit known model roots
sports/nba/predictions/Player-Predictor/model/
sports/nba/predictions/model_root_legacy/
Player-Predictor/model/
Player-Predictor/models/

# Generic model output folders
**/model/
**/models/
**/checkpoints/
**/checkpoint/
**/saved_model/
**/model_artifacts/
**/model_outputs/
**/model_metadata/
**/training_runs/

# Experiment trackers / generated ML metadata
wandb/
**/wandb/

mlruns/
**/mlruns/

runs/
**/runs/

tensorboard/
**/tensorboard/

lightning_logs/
**/lightning_logs/

catboost_info/
**/catboost_info/


# ============================================================
# Trained model binary formats
# ============================================================
*.keras
*.h5
*.hdf5
*.onnx
*.pt
*.pth
*.ckpt
*.safetensors
*.tflite
*.pb
*.pbtxt


# ============================================================
# Model/scaler/encoder artifacts
# ============================================================
# These are usually generated metadata, not source data.
*.joblib

# Be careful with global *.pkl ignores because some projects store datasets as pickle.
# This only ignores pickle files inside model-ish folders.
**/model/**/*.pkl
**/models/**/*.pkl
**/model_artifacts/**/*.pkl
**/model_outputs/**/*.pkl
**/checkpoints/**/*.pkl
**/training_runs/**/*.pkl

**/model/**/*.json
**/models/**/*.json
**/model_artifacts/**/*.json
**/model_outputs/**/*.json
**/checkpoints/**/*.json
**/training_runs/**/*.json


# ============================================================
# Generated web/build outputs
# ============================================================
# Keep root dist tracked if this is your deployed static bundle.
# Ignore deprecated/generated nested dist folders.
sports/nba/dist/
sports/mlb/dist/
sports/nfl/dist/

sports/nba/web/art/
sports/nba/web/images/
sports/nba/dist/art/
sports/nba/dist/images/

web/nba-card-display/


# ============================================================
# Local exploratory scripts you explicitly do not want tracked
# ============================================================
sports/nba/predictions/Player-Predictor/decision_engine/staking_bucket_model_v2.py
sports/nba/predictions/Player-Predictor/scripts/analyze_miss_taxonomy.py
sports/nba/predictions/Player-Predictor/scripts/evaluate_fp_veto_behavior.py
sports/nba/predictions/Player-Predictor/scripts/evaluate_overlay_frontier.py
sports/nba/predictions/Player-Predictor/scripts/evaluate_staking_shadow_rolling.py
sports/nba/predictions/Player-Predictor/scripts/generate_abs_edge_policy_brief.py
sports/nba/predictions/Player-Predictor/scripts/train_staking_bucket_model_v2.py


# ============================================================
# Optional: large archive/backups
# ============================================================
# Uncomment only if these become too large/noisy.
# backups/
# archive/
# **/backups/
# **/archive/
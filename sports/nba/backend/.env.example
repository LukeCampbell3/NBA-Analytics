# NBA Analytics backend / API
DATABASE_URL=sqlite:///sports/nba/backend/data/nba_analytics.db
JWT_SECRET=change-me-in-production
ALLOW_DEV_AUTH=1
SITE_URL=http://localhost:8080
ARTIFACT_DATA_DIR=sports/nba/web/data
CORS_ALLOW_ORIGINS=http://localhost:8080,http://127.0.0.1:8080

# Stripe (server-side only — never expose to frontend)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
